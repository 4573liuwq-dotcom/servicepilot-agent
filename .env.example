# 任意 OpenAI 兼容接口均可（OpenAI / DeepSeek / 通义兼容模式 / 硅基流动 / OpenRouter）
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# 第一次学习建议先用 true：无需 API、零成本跑通完整工作流
DEMO_MODE=true

# 可选：开启真实联网检索；未配置时仍可使用本地企业知识库
TAVILY_API_KEY=

# 生产环境建议配置，客户端通过 X-API-Key 访问
APP_API_KEY=
REQUIRE_PLAN_APPROVAL=false
MAX_REFLECTION_LOOPS=2
DATABASE_PATH=data/insightforge.db
LOG_LEVEL=INFO

